{
  "name": "yilong-portfolio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8765 --turbopack",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "test": "yarn test:unit",
    "test:pre-commit": "yarn test:unit:ci && yarn test:component && yarn test:e2e:chrome",
    "test:ci": "yarn test:unit:ci && yarn test:component && CYPRESS_BASE_URL=http://localhost:3000 yarn test:e2e:chrome",
    "test:e2e": "cypress open",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:headless": "cypress run",
    "test:component": "cypress run --component",
    "test:unit": "vitest",
    "test:unit:ci": "vitest --run",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown .",
    "lint": "next lint && tsc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@next/bundle-analyzer": "^15.2.4",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-spring/three": "9.7.5",
    "@react-spring/web": "9.7.5",
    "@react-three/drei": "^10.0.5",
    "@react-three/fiber": "^9.1.0",
    "@types/three": "^0.174.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.484.0",
    "next": "15.2.4",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.174.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.6",
    "@storybook/addon-essentials": "^8.6.9",
    "@storybook/addon-interactions": "^8.6.9",
    "@storybook/addon-links": "^8.6.9",
    "@storybook/addon-onboarding": "^8.6.9",
    "@storybook/blocks": "^8.6.9",
    "@storybook/nextjs": "^8.6.9",
    "@storybook/react": "^8.6.9",
    "@storybook/test": "^8.6.9",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/node": "^22.13.13",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "cypress": "^14.2.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-storybook": "^0.12.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-responsive": "^10.0.1",
    "storybook": "^8.6.9",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=20.15.0"
  }
}
