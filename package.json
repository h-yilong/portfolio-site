{
  "name": "yilong-portfolio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8765 --turbopack",
    "build": "yarn prisma generate && next build",
    "build:analyze": "yarn prisma generate && ANALYZE=true next build",
    "start": "next start",
    "test": "yarn test:unit",
    "test:pre-commit": "yarn test:unit:ci && yarn test:component && yarn test:e2e:chrome",
    "test:ci": "yarn test:unit:ci && yarn test:component && CYPRESS_BASE_URL=http://localhost:3000 yarn test:e2e:chrome",
    "test:e2e": "cypress open",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:headless": "cypress run",
    "test:component": "cypress run --component",
    "test:unit": "vitest",
    "test:unit:ci": "vitest --run",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown .",
    "lint": "next lint && tsc",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^15.5.6",
    "@next/mdx": "^15.5.6",
    "@prisma/client": "^6.17.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-spring/three": "10.0.3",
    "@react-spring/web": "10.0.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.1.0",
    "@types/mdx": "^2.0.13",
    "@types/three": "^0.180.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.546.0",
    "maath": "^0.10.8",
    "next": "15.5.6",
    "next-themes": "^0.4.6",
    "prisma": "^6.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.180.0",
    "three-stdlib": "^2.36.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cypress/react18": "^2.0.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "cypress": "^15.5.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react-responsive": "^10.0.1",
    "shadcn": "^3.4.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.18.0"
  }
}
